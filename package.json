{
  "name": "supay",
  "description": "Supay web components built with Lit, Tailwind CSS, Material Design 3, Vite, and Storybook.",
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Benito Anagua",
    "email": "benito.anagua@gmail.com",
    "url": "https://benitoanagua.me"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/benitoanagua/Supay.git"
  },
  "bugs": "https://github.com/benitoanagua/Supay/issues",
  "demo": "https://benitoanagua.github.io/Supay",
  "keywords": [
    "supay",
    "andean",
    "cultural",
    "tailwind",
    "material-design",
    "lit"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "prettier": "prettier --write \"src/**/*.{js,ts,html,css}\" \"test/**/*.{ts,js}\" \"*.{ts,json,md}\"",
    "prettier:check": "prettier --check \"src/**/*.{js,ts,html,css}\" \"test/**/*.{ts,js}\" \"*.{ts,json,md}\"",
    "format": "pnpm prettier",
    "lint": "pnpm prettier:check && pnpm type-check",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "generate:theme": "tsx src/plugins/material-theme/cli.ts",
    "prebuild": "pnpm generate:theme",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm prettier:check && pnpm type-check && pnpm test",
    "ci": "pnpm check && pnpm test:coverage && pnpm build && pnpm build-storybook"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.25",
    "@iconify/tailwind4": "^1.2.3",
    "@material/material-color-utilities": "^0.3.0",
    "@ngneat/falso": "^8.0.2",
    "@storybook/addon-a11y": "^8.6.18",
    "@storybook/addon-essentials": "^8.6.18",
    "@storybook/html": "^8.6.18",
    "@storybook/html-vite": "^8.6.18",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "storybook": "^8.6.18",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "browserslist": [
    "last 2 versions and not dead"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "license"
  ],
  "sideEffects": [
    "**/*.css"
  ]
}
